{
  "name": "www-root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/compile-content-json.mjs && node scripts/compile-swf-compare.mjs && next dev",
    "prebuild": "node scripts/copy-ruffle.mjs && node scripts/copy-awayfl.mjs && node scripts/compile-content-json.mjs && node scripts/compile-swf-compare.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-ruffle.mjs && node scripts/copy-awayfl.mjs && node scripts/sync-content-images.mjs && node scripts/sync-content-json.mjs && node scripts/compile-swf-compare.mjs",
    "sync:images": "node scripts/sync-content-images.mjs",
    "compile:json": "node scripts/compile-content-json.mjs",
    "json:items": "node scripts/set-items.mjs",
    "sync:json": "node scripts/sync-content-json.mjs",
    "swf-compare:sync": "node scripts/sync-swf-compare.mjs",
    "swf-compare:html": "node scripts/compile-swf-compare.mjs",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod"
  },
  "dependencies": {
    "@awayfl/awayfl-player": "^0.2.54",
    "@gsap/react": "^2.1.2",
    "@ruffle-rs/ruffle": "^0.7.1",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.3.2",
    "typescript": "^7",
    "vercel": "^65.2.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10"
}
