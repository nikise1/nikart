# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# ruffle/awayfl runtimes (copied from node_modules via postinstall/prebuild)
/public/ruffle/
/public/awayfl/*
!/public/awayfl/loadvars-ondata-patch.js

# generated catalog from swf-compare:sync
/public/swf-compare/generated-catalog.json

# compare HTML compiled from public/swf-compare/pages.json
/public/swf-compare/index.html
/public/swf-compare/visibility-defaults.json
/public/swf-compare/*/

# generated from repo-root public/content/img (see scripts/sync-content-images.mjs)
/public/_generated/

# generated from repo-root public/content/json/data.json (see scripts/sync-content-json.mjs)
/public/content/json/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
