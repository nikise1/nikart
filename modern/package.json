{
  "name": "modern",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10",
  "scripts": {
    "dev": "node scripts/compile-swf-compare.mjs && next dev",
    "prebuild": "node scripts/copy-ruffle.mjs && node scripts/copy-awayfl.mjs && node scripts/compile-swf-compare.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node -e \"const fs=require('node:fs');const p='node_modules/.bin/tsc';fs.rmSync(p,{force:true});fs.symlinkSync('../typescript/bin/tsc',p)\" && node scripts/copy-ruffle.mjs && node scripts/copy-awayfl.mjs && node scripts/sync-content-images.mjs && node scripts/sync-content-json.mjs && node scripts/compile-swf-compare.mjs",
    "sync:images": "node scripts/sync-content-images.mjs",
    "sync:json": "node scripts/sync-content-json.mjs",
    "swf-compare:sync": "node scripts/sync-swf-compare.mjs",
    "swf-compare:html": "node scripts/compile-swf-compare.mjs",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@awayfl/awayfl-player": "^0.2.54",
    "@gsap/react": "^2.1.2",
    "@ruffle-rs/ruffle": "^0.6.0",
    "gsap": "^3.15.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7",
    "vercel": "^62.2.0",
    "vitest": "^4.1.10"
  }
}
