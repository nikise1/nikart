{
  "name": "nikart",
  "install": "npm install --prefix legacy-2014 && npm install --prefix modern",
  "terminals": [
    {
      "name": "modern",
      "command": "npm run modern",
      "description": "Main app: Next.js 16 dev server (http://localhost:3000)."
    },
    {
      "name": "legacy",
      "command": "npm run legacy-2014",
      "description": "Legacy Express/Swig site in legacy-2014/ (http://localhost:5000)."
    }
  ],
  "ports": [
    { "name": "modern", "port": 3000 },
    { "name": "legacy", "port": 5000 }
  ]
}
